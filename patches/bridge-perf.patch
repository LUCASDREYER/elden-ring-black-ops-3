diff --git a/elden-ring/er-bridge/src/memutil.cpp b/elden-ring/er-bridge/src/memutil.cpp
index f629114..6cc2118 100644
--- a/elden-ring/er-bridge/src/memutil.cpp
+++ b/elden-ring/er-bridge/src/memutil.cpp
@@ -11,14 +11,37 @@ static bool protect_readable(DWORD p) {
                  PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)) != 0;
 }
 
+// Readable regions VirtualQuery confirmed this tick. Under Wine and Rosetta each query is a
+// slow system call, and publishing entities checks several pointers for each of up to ~1,300
+// characters a tick (8.5 ms in the Stranded Graveyard). Characters live in a few large heap
+// regions, so after the first query almost every check is a range comparison. Per thread;
+// mem_cache_reset() at the start of each game tick keeps entries to one tick, as fresh as the
+// pointers they vouch for.
+namespace {
+struct Region {
+    uintptr_t lo, hi;
+};
+constexpr int kRegions = 32;
+thread_local Region t_regions[kRegions];
+thread_local int t_regionCount = 0, t_regionNext = 0;
+}  // namespace
+
+void mem_cache_reset() { t_regionCount = 0; t_regionNext = 0; }
+
 bool mem_readable(const void* p, size_t len) {
     uintptr_t a = (uintptr_t)p, end = a + len;
     if (a < 0x10000 || end < a) return false;
+    for (int i = 0; i < t_regionCount; i++)
+        if (a >= t_regions[i].lo && end <= t_regions[i].hi) return true;
     while (a < end) {
         MEMORY_BASIC_INFORMATION mbi;
         if (!VirtualQuery((void*)a, &mbi, sizeof(mbi))) return false;
         if (mbi.State != MEM_COMMIT || !protect_readable(mbi.Protect)) return false;
-        a = (uintptr_t)mbi.BaseAddress + mbi.RegionSize;
+        uintptr_t lo = (uintptr_t)mbi.BaseAddress, hi = lo + mbi.RegionSize;
+        t_regions[t_regionNext] = {lo, hi};
+        t_regionNext = (t_regionNext + 1) % kRegions;
+        if (t_regionCount < kRegions) t_regionCount++;
+        a = hi;
     }
     return true;
 }
